{
  "name": "view_update",
  "description": "Replace a live card of this conversation with a whole new View (rules as view_show); no other conversation or agent can. A version from view_get refuses a stale update; without one, the version read now is used. A refused update leaves the card as it was. Updates are stored at once and told at most once a second. Returns {version}. Keep component keys stable.",
  "input_schema": {
    "type": "object",
    "required": [
      "id",
      "view"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "The exact id returned by view_show, including its view_ prefix."
      },
      "view": {
        "type": "object",
        "description": "The entire replacement View, including required plain-text fallback."
      },
      "version": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "Expected version from view_get; a stale version returns a conflict instead of overwriting."
      }
    }
  }
}
