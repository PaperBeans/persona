{
  "name": "interaction_answer",
  "description": "Answer another agent's card for the user, in their place, when they said what to answer or told you to decide. Answer each question by its own wording with an option label it offers; no free text (use agent_send). A multi-select takes an array of labels. A card a 督办 message handed you (a task you supervise) is yours to decide: answer a question, or allow or deny a tool permission or a plan with allow, giving reason; it is kept as the task's decision, never as the user's. Forms, secrets and approvals that send or reply in the user's name, spend money or delete are the user's: ask_escalate them. Never other approvals, terminal dialogs or the assistant's own questions.",
  "input_schema": {
    "type": "object",
    "required": [
      "machine",
      "session_id",
      "interaction_id"
    ],
    "properties": {
      "machine": {
        "type": "string",
        "description": "the machine's id or name, as agents_list shows it"
      },
      "session_id": {
        "type": "string",
        "description": "the agent's session id, or its first 8 characters"
      },
      "interaction_id": {
        "type": "string",
        "description": "the waiting interaction's id, from agents_list"
      },
      "answers": {
        "type": "object",
        "description": "each question's own wording → the option label to pick; a multi-select gives an array of labels",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "allow": {
        "type": "boolean",
        "description": "a permission or plan card: true allows (approves), false denies"
      },
      "reason": {
        "type": "string",
        "description": "in a sentence, why this answer (kept with the task's decision)"
      }
    }
  }
}
